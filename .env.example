# Safivra Environment Variables

# ── Supabase (REQUIRED for production) ───────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Sentry Error Tracking (OPTIONAL, recommended for production) ──────────────
# Get from: sentry.io → Create Project → React → DSN
# Leave empty or omit in local dev — Sentry only initializes if this is set.
# IMPORTANT: Never log financial amounts or user identifiers in error messages.
VITE_SENTRY_DSN=

# ── App Version (OPTIONAL) ────────────────────────────────────────────────────
# Used by Sentry to tag releases. Set this in Vercel as the git SHA or semver.
VITE_APP_VERSION=1.0.0

# ── Demo Mode (OPTIONAL, NEVER enable in production) ─────────────────────────
# Set to true ONLY for local dev demos with no real Supabase credentials.
# When false (default): missing Supabase credentials = clear error, no redirect.
# When true:            app runs in offline demo mode with in-memory data.
VITE_ENABLE_DEMO_MODE=false
